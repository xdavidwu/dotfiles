#!/bin/sh

set -e

[ ! -f "$1" ] && exit 1

IFS=$'\n'

FLAG=1
TITLE=
ARGS=
for i in $(youtube-dl -xeg --audio-format best $(cat $@));do
	if [ $FLAG -eq 1 ];then #title
		FLAG=2
		TITLE=$i
	else #url
		FLAG=1
		ARGS="$ARGS"$'\n'"$i"$'\n'":meta-title=$TITLE"
		TITLE=
	fi
done

echo cvlc $ARGS

cvlc $ARGS

